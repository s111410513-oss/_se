# Normalise line endings so diffs stay clean across Windows/macOS/Linux.
* text=auto eol=lf

# Scripts must keep LF so they stay executable on Unix.
*.sh text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf

# Binary assets are never touched.
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.whl binary